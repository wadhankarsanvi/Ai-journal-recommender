# ==============================================================================
# AI-Based Journal Recommendation Assistant - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Academic APIs (100% FREE - No Paid Keys Required)
# ------------------------------------------------------------------------------
# OpenAlex and Crossref provide polite-pool access if you supply an email address.
OPENALEX_EMAIL=sanvi.wadhankar.batch2024@sitnagpur.siu.edu.in
CROSSREF_EMAIL=sanvi.wadhankar.batch2024@sitnagpur.siu.edu.in

# Optional: Semantic Scholar API Key (Increases rate limit if you have one)
# SEMANTIC_SCHOLAR_API_KEY=your_key_here

# ------------------------------------------------------------------------------
# 2. Optional LLM API Keys (For enhanced multi-model reasoning & synthesis)
# The system works 100% out of the box with heuristic explainability even without these keys!
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get free from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI API Key (Get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Groq API Key (Get free from: https://console.groq.com/keys)
GROQ_API_KEY=

# LLM Provider: 'auto', 'gemini', 'openai', 'groq', or 'heuristic'
LLM_PROVIDER=auto

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=7860
DEBUG=false
VECTORSTORE_DIR=data/vectorstore
